rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } 
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.uid == '1LGGxE2EdbdVzBaGkIxHIaGgGBJ3' ||
        request.auth.token.email.lower() == 'nupeshpatel4342@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Collections ---

    // 1. Products: The core shop items
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'category', 'price', 'unit']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
               data.price is number && data.price >= 0 &&
               data.unit is string && data.unit.size() > 0 && data.unit.size() <= 50;
      }

      // Public can see all products
      allow get: if true;
      allow list: if true;

      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());

      allow update: if isAdmin() && isValidProduct(incoming());

      allow delete: if isAdmin();
    }

    // 4. Categories: Collection of shop categories
    match /categories/{categoryId} {
      function isValidCategory(data) {
        return data.keys().hasAll(['name']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200;
      }

      allow get: if true;
      allow list: if true;

      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());

      allow update: if isAdmin() && isValidCategory(incoming());

      allow delete: if isAdmin();
    }

    // 2. Settings: Global shop configuration
    match /settings/global {
      function isValidSettings(data) {
        return data.keys().hasAll(['customCategories', 'customUnits', 'qrValue']) &&
               data.keys().size() <= 5 &&
               data.customCategories is list && data.customCategories.size() <= 200 &&
               data.customUnits is list && data.customUnits.size() <= 100 &&
               data.qrValue is string && data.qrValue.size() <= 2048;
      }

      allow get: if true;
      allow list: if false; // Singleton doc, no listing

      allow write: if isAdmin() && isValidSettings(incoming());
    }

    // 3. Admins: Managed roles
    match /admins/{userId} {
      allow read: if isVerified();
      allow write: if false; // Strict: Console only management
    }
  }
}
