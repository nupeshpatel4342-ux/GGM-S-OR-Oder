{
  "name": "GGM&S Grocery",
  "short_name": "GGM&S",
  "description": "Premium wholesale & retail grocery ordering web application.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "scope_extensions": [
    { "origin": "https://*.firebaseapp.com" },
    { "origin": "https://*.google.com" },
    { "origin": "https://*.googleusercontent.com" }
  ],
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#0f172a",
  "orientation": "portrait",
  "categories": ["shopping", "food"],
  "iarc_rating_id": "e84bc34b-149b-4498-8e6f-fb2bbfbb94d5",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.ggms.grocery",
      "url": "https://play.google.com/store/apps/details?id=com.ggms.grocery"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "GGM&S Grocery Mobile Interface"
    },
    {
      "src": "/screenshot-wide.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "form_factor": "wide",
      "label": "GGM&S Grocery Shop Interface"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop Grocery",
      "short_name": "Shop",
      "description": "Start shopping fresh groceries",
      "url": "/?ref=shortcut_shop",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Cart",
      "short_name": "Cart",
      "description": "View items in your shopping cart",
      "url": "/?ref=shortcut_cart",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/?file-handler",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      },
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
